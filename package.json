{
  "name": "dsh-shotcut",
  "version": "1.1.0",
  "description": "Scissors screenshot button in the DSH chat composer (Windows). Captures the whole desktop while this window is temporarily transparent, freezes the frame edge to edge, then crops/annotates and drops the result straight into the composer.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "capture.py",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "screenshot",
    "screen-capture",
    "annotation"
  ],
  "license": "MIT",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wyy1972/dsh-shotcut.git"
  },
  "homepage": "https://github.com/Wyy1972/dsh-shotcut#readme",
  "bugs": {
    "url": "https://github.com/Wyy1972/dsh-shotcut/issues"
  }
}
